# Pinned Kimodo toolchain for the clip pipeline. Bump these together and rerun animation/fetch.sh.
KIMODO_REPO=https://github.com/localai-org/kimodo.cpp.git
KIMODO_COMMIT=ed8a931aedb132f768190f6931c365855caba74c
KIMODO_MOTION_MODEL=g1-rp-v1
KIMODO_MOTION_REPO=LocalAI-io/Kimodo-G1-RP-v1-GGML
KIMODO_MOTION_FILE=models/kimodo-g1-rp-v1-f32.gguf
# Q8_0 is the upstream default (8.1 GB); q4_k_m (5.1 GB) is what this pipeline ships with.
KIMODO_TEXT_QUANTIZATION=q4_k_m
