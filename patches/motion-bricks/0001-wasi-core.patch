diff --git a/src/memory_bundle.cpp b/src/memory_bundle.cpp
new file mode 100644
index 0000000..cf0ae9e
--- /dev/null
+++ b/src/memory_bundle.cpp
@@ -0,0 +1,77 @@
+#include "memory_bundle.hpp"
+
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace motionbricks::detail {
+
+namespace {
+
+struct registered_file {
+    std::string name;
+    std::unique_ptr<std::byte[]> storage;
+    memory_file view;
+};
+
+std::vector<registered_file> & registry() {
+    static std::vector<registered_file> files;
+    return files;
+}
+
+registered_file * find_registered(std::string_view name) {
+    for (auto & file : registry()) {
+        if (file.name == name) return &file;
+    }
+    return nullptr;
+}
+
+} // namespace
+
+bool memory_bundle_active() noexcept {
+    return !registry().empty();
+}
+
+const memory_file * find_memory_file(const std::filesystem::path & path) noexcept {
+    const auto * file = find_registered(path.filename().string());
+    return file == nullptr ? nullptr : &file->view;
+}
+
+} // namespace motionbricks::detail
+
+extern "C" {
+
+int mb_memory_file_begin(const char * name, uint64_t size) {
+    if (name == nullptr || size == 0U || size > SIZE_MAX / 2U) return -1;
+    auto & files = motionbricks::detail::registry();
+    for (auto it = files.begin(); it != files.end(); ++it) {
+        if (it->name == name) {
+            files.erase(it);
+            break;
+        }
+    }
+    const auto bytes = static_cast<std::size_t>(size);
+    auto storage = std::make_unique<std::byte[]>(bytes);
+    const auto * data = storage.get();
+    files.push_back({name, std::move(storage), {data, bytes}});
+    return 0;
+}
+
+int mb_memory_file_write(const char * name, uint64_t offset, const void * data, uint64_t count) {
+    if (name == nullptr || (data == nullptr && count != 0U)) return -1;
+    auto * file = motionbricks::detail::find_registered(name);
+    if (file == nullptr || offset > file->view.size || count > file->view.size - offset) return -1;
+    if (count != 0U) {
+        std::memcpy(file->storage.get() + offset, data, static_cast<std::size_t>(count));
+    }
+    return 0;
+}
+
+void mb_memory_files_clear(void) {
+    motionbricks::detail::registry().clear();
+}
+
+}
diff --git a/src/memory_bundle.hpp b/src/memory_bundle.hpp
new file mode 100644
index 0000000..50af395
--- /dev/null
+++ b/src/memory_bundle.hpp
@@ -0,0 +1,34 @@
+#pragma once
+
+// Bundle files supplied as bytes by a host without filesystem access (the WASI component).
+// A registered file answers for any path with the same file name, so the loader's
+// `<bundle>/<component>.gguf` paths resolve to the registered bytes. Native builds never register.
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+
+namespace motionbricks::detail {
+
+struct memory_file {
+    const std::byte * data;
+    std::size_t size;
+};
+
+// True once any file has been registered.
+bool memory_bundle_active() noexcept;
+
+// The registered file named like path's file name, or nullptr.
+const memory_file * find_memory_file(const std::filesystem::path & path) noexcept;
+
+} // namespace motionbricks::detail
+
+extern "C" {
+
+// Host API for the component glue. Each returns 0 on success and -1 on failure.
+// Registering a name again replaces it. Chunks may arrive in any order within bounds.
+int mb_memory_file_begin(const char * name, uint64_t size);
+int mb_memory_file_write(const char * name, uint64_t offset, const void * data, uint64_t count);
+void mb_memory_files_clear(void);
+
+}
