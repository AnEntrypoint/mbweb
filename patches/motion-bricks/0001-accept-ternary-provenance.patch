+// Ternary bundles (tools/ternary/export_gguf.py) record "ternary:<sha256>" of the trained
+// checkpoint in motionbricks.source_sha256 instead of upstream's trusted-extraction hash.
+bool metadata_source(const gguf_context * context, const char * key,
+                     std::string_view expected, std::string & reason) {
+    const auto index = gguf_find_key(context, key);
+    if (index < 0 || gguf_get_kv_type(context, index) != GGUF_TYPE_STRING) {
+        reason = std::string("missing string metadata: ") + key;
+        return false;
+    }
+    const std::string_view actual(gguf_get_val_str(context, index));
+    if (actual == expected) {
+        return true;
+    }
+    if (actual.size() == 8 + 64 && actual.substr(0, 8) == "ternary:") {
+        return true;
+    }
+    reason = std::string("incompatible metadata value: ") + key;
+    return false;
+}
